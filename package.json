{
  "name": "subtrack",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "server",
    "mobile"
  ],
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "dev:vite": "npm run dev:web",
    "build": "npm --workspace server run build && npm --workspace web run build",
    "build:web": "npm --workspace web run build",
    "build:server": "npm --workspace server run build",
    "start": "npm --workspace server run start",
    "test": "npm run test:server && npm run test:web && npm run test:mobile",
    "test:server": "npm --workspace server run test",
    "test:api": "npm run test:server",
    "test:web": "npm --workspace web run test",
    "test:mobile": "npm --workspace mobile run test",
    "test:coverage": "npm run test:server:coverage && npm run test:web:coverage && npm run test:mobile:coverage",
    "test:server:coverage": "npm --workspace server run test:coverage",
    "test:api:coverage": "npm run test:server:coverage",
    "test:web:coverage": "npm --workspace web run test:coverage",
    "test:mobile:coverage": "npm --workspace mobile run test:coverage",
    "typecheck": "npm --workspace server run typecheck && npm --workspace web run typecheck && npm --workspace mobile run typecheck",
    "prisma:generate": "npm --workspace server run prisma:generate",
    "prisma:migrate": "npm --workspace server run prisma:migrate",
    "prisma:deploy": "npm --workspace server run prisma:deploy"
  },
  "allowScripts": {
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.0": true,
    "prisma@6.19.3": true
  }
}
